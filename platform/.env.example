# Copy to .env for local use. Never commit real values.

# Application connection. In production this is the login role that is a member of app_role
# (INSERT/SELECT/UPDATE on business tables; no DELETE; append-only audit).
DATABASE_URL=postgres://postgres@localhost:5432/gh_platform

# Tests only: a superuser connection used to create and drop a throwaway database per run.
TEST_DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres

# docker compose only
POSTGRES_PASSWORD=change-me-locally
